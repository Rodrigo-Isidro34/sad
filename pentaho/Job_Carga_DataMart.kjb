    <entry>
      <name>Criar Tabelas Dimensao</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TABLE IF NOT EXISTS tempo (
  pk_tempo SERIAL PRIMARY KEY,
  data_completa DATE,
  ano INTEGER,
  mês INTEGER,
  dia INTEGER
);

CREATE TABLE IF NOT EXISTS categoria (
  pk_categoria SERIAL PRIMARY KEY,
  categoria_principal VARCHAR(255),
  subcategoria VARCHAR(255)
);

CREATE TABLE IF NOT EXISTS localizacao (
  pk_localizacao SERIAL PRIMARY KEY,
  pais VARCHAR(255),
  estado VARCHAR(255),
  cidade VARCHAR(255)
);

CREATE TABLE IF NOT EXISTS projeto (
  pk_projeto SERIAL PRIMARY KEY,
  nome_projeto TEXT,
  status VARCHAR(100),
  destaque_staff BOOLEAN
);

CREATE TABLE IF NOT EXISTS criador (
  pk_criador SERIAL PRIMARY KEY,
  nome_criador VARCHAR(500)
);

CREATE TABLE IF NOT EXISTS projetos_kickstarter (
  fk_projeto INTEGER,
  fk_categoria INTEGER,
  fk_localizacao INTEGER,
  fk_criador INTEGER,
  fk_data_lancamento INTEGER,
  fk_data_deadline INTEGER,
  meta_usd DOUBLE PRECISION,
  valor_arrecadado_usd DOUBLE PRECISION,
  qtd_apoiadores INTEGER,
  duracao_dias DOUBLE PRECISION,
  flag_sucesso BOOLEAN
);

TRUNCATE TABLE projetos_kickstarter, tempo, categoria, localizacao, projeto, criador RESTART IDENTITY CASCADE;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>DW_Kickstarter</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>160</xloc>
      <yloc>32</yloc>
      <attributes_kjc/>
    </entry>
