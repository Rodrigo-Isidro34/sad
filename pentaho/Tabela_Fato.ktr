    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var dl_raw = new Date(launched_at * 1000);
var dd_raw = new Date(deadline * 1000);

var data_lancamento = new Date(dl_raw.getFullYear(), dl_raw.getMonth(), dl_raw.getDate());
var data_deadline = new Date(dd_raw.getFullYear(), dd_raw.getMonth(), dd_raw.getDate());

var ano_lancamento = dl_raw.getFullYear();
var mes_lancamento = dl_raw.getMonth() + 1;
var dia_lancamento = dl_raw.getDate();

var ano_deadline = dd_raw.getFullYear();
var mes_deadline = dd_raw.getMonth() + 1;
var dia_deadline = dd_raw.getDate();

// Flag de sucesso condicional
var flag_sucesso = (usd_pledged &gt;= goal) ? true : false;</jsScript_script>
      </jsScript>
    </jsScripts>
